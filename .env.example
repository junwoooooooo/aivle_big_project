# Docker Compose configuration for the current production platform modules.
# Copy to .env and provide local values. Never commit real secrets.
# Required for real AI execution. These values are consumed only by ai-server.
# AI_PROVIDER supports openai or openai-compatible. AI_BASE_URL is optional for openai.
AI_PROVIDER=
AI_API_KEY=
MARKET_RESEARCH_OPENAI_API_KEY=
# Direct Research2 compatibility. Compose gives the dedicated wallet above precedence.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Official Market FULL data-adapter keys. Without a key, that channel may fail or produce partial evidence.
KOSIS_API_KEY=
DART_API_KEY=
TAVILY_API_KEY=
# Optional TechOps Layer 2 enrichment. DART registry lookup is disabled unless explicitly enabled.
TECH_OPS_ENABLE_DART_CORP_LOOKUP=false
TECH_OPS_ADVISOR_MODEL=
# Leave empty to use AI_MODEL. Set only when Business Model needs a dedicated model.
BM_MODEL=
TWIN_BANK_HOST_DIR=../aivle_private_assets/twin-bank
TWIN_CONCURRENCY=32
AI_MODEL=
MARKETING_COPY_MODEL=gpt-4o-mini
MARKETING_IMAGE_MODEL=gpt-image-2
# Direct Marketing Content image-generation compatibility; Compose maps the model above to this name.
AI_IMAGE_MODEL=gpt-image-2
AI_MODEL_CONCEPT_VALIDATION=
AI_BASE_URL=
AI_INTERNAL_SERVICE_TOKEN=
# AI trace callback target. compose.yaml uses the fixed backend service URL.
BACKEND_INTERNAL_BASE_URL=http://backend:8080
# Keep false: production behavior never uses a fixture or success fallback.
AI_FIXTURE_MODE=false
AI_PROVIDER_TIMEOUT_SECONDS=60
# Concurrent provider calls; this does not change CPV2 bounded-execution semantics. Allowed: 1-3.
AI_CONCEPT_GENERATION_CONCURRENCY=1
# Development/regression fault injection only. Normal runtime must remain false / empty.
AI_CONCEPT_TEST_FAILURE_INJECTION=false
AI_CONCEPT_TEST_FAILURE_PLAN=
AI_SERVER_READ_TIMEOUT=300s
AI_SERVER_TWIN_SURVEY_READ_TIMEOUT=14m
AI_SERVER_CONNECT_TIMEOUT=3s
AI_SERVER_BASE_URL=http://127.0.0.1:8000
AI_SERVER_INTERNAL_API_KEY=
AI_SERVER_CONCEPT_PORTFOLIO_READ_TIMEOUT=15m
AI_APP_ENVIRONMENT=LOCAL

# Official legal source pipeline (consumed only by ai-server).
# Set MOLEG_API_KEY before validating real legal-source retrieval.
MOLEG_API_KEY=
MOLEG_API_BASE_URL=https://www.law.go.kr/DRF
LEGAL_REGISTRY_VERSION=legal-registry-v1
LEGAL_PROVIDER_TIMEOUT_SECONDS=30
LEGAL_SOURCE_CACHE_SECONDS=3600
#APP_TASK_RUN_LEGAL_PRECHECK_POLL_INTERVAL_MS=1000

# Application services. JWT_SECRET and POSTGRES_PASSWORD are required by compose.
JWT_SECRET=
JWT_ISSUER=aivle-business-validation
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_CLOCK_SKEW=30s
APP_ENVIRONMENT=LOCAL
POSTGRES_DB=aivle
POSTGRES_USER=aivle
POSTGRES_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_PORT=3000

# Optional first local administrator (leave disabled after provisioning)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Object storage for uploaded files
MINIO_ROOT_USER=aivle-local
MINIO_ROOT_PASSWORD=
OBJECT_STORAGE_BUCKET=aivle-ai-artifacts
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=./data/objects
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PATH_STYLE_ACCESS=true
OBJECT_STORAGE_CONNECT_TIMEOUT=3s
OBJECT_STORAGE_READ_TIMEOUT=30s
OBJECT_STORAGE_PRESIGNED_GET_EXPIRY=5m
OBJECT_STORAGE_PRESIGNED_PUT_EXPIRY=5m
OBJECT_STORAGE_ARTIFACT_MAX_SIZE=32MB
AI_ARTIFACT_HTTP_TIMEOUT_SECONDS=10
AI_ARTIFACT_MAX_BYTES=1048576

# Direct Spring/PostgreSQL execution (Compose injects these values from POSTGRES_*).
DB_URL=jdbc:postgresql://localhost:5432/aivle
DB_USERNAME=aivle
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000

# Direct AI Twin execution only. Compose fixes this to /app/app/twin/bank.
TWIN_BANK_DIR=
VITE_ENABLE_PIPELINE_DEBUG=false

# Local background processing
