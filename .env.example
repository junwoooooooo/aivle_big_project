# Local configuration template. Copy to .env and keep real secrets untracked.
# Empty required values intentionally fail fast; comments carry the explanation.

# ============================================================
# 1. REQUIRED — Docker Compose
# ============================================================
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_INTERNAL_SERVICE_TOKEN=
JWT_SECRET=
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
TWIN_BANK_HOST_DIR=../aivle_private_assets/twin-bank

POSTGRES_DB=aivle
POSTGRES_USER=aivle
MINIO_ROOT_USER=aivle-local
OBJECT_STORAGE_BUCKET=aivle-ai-artifacts
APP_ENVIRONMENT=LOCAL
AI_APP_ENVIRONMENT=LOCAL
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_PORT=3000

# Backend → AI transport classes. Short tasks remain short; Market fresh collection
# has a 20-minute worker deadline and a 22-minute transport/lease envelope.
AI_SERVER_CONNECT_TIMEOUT=3s
AI_SERVER_READ_TIMEOUT=30s
AI_SERVER_LONG_READ_TIMEOUT=7m
AI_SERVER_MARKET_RESEARCH_READ_TIMEOUT=22m
AI_SERVER_CONCEPT_PORTFOLIO_READ_TIMEOUT=15m
AI_SERVER_TWIN_SURVEY_READ_TIMEOUT=14m

# ============================================================
# 2. REQUIRED — Market Research
# ============================================================
# Research2 requires one of these keys. Compose gives the dedicated wallet priority:
# MARKET_RESEARCH_OPENAI_API_KEY → OPENAI_API_KEY.
# AI_API_KEY alone configures general structured AI, not Market Research2.
MARKET_RESEARCH_OPENAI_API_KEY=
OPENAI_API_KEY=
# A custom endpoint must support the OpenAI Responses API and web_search tools used
# by Research2. Leave empty for the standard OpenAI endpoint.
OPENAI_BASE_URL=

# ============================================================
# 3. OPTIONAL — external data sources
# ============================================================
KOSIS_API_KEY=
DART_API_KEY=
TAVILY_API_KEY=
MOLEG_API_KEY=
MOLEG_API_BASE_URL=https://www.law.go.kr/DRF
LEGAL_REGISTRY_VERSION=legal-registry-v1
LEGAL_PROVIDER_TIMEOUT_SECONDS=30
LEGAL_SOURCE_CACHE_SECONDS=3600
TECH_OPS_ENABLE_DART_CORP_LOOKUP=false

# ============================================================
# 4. OPTIONAL — model and runtime overrides
# ============================================================
AI_BASE_URL=
AI_MODEL_CONCEPT_VALIDATION=
BM_MODEL=
TECH_OPS_ADVISOR_MODEL=
MARKETING_COPY_MODEL=gpt-4o-mini
MARKETING_IMAGE_MODEL=gpt-image-2
AI_PROVIDER_TIMEOUT_SECONDS=60
AI_CONCEPT_GENERATION_CONCURRENCY=1
TWIN_CONCURRENCY=32

JWT_ISSUER=aivle-business-validation
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_CLOCK_SKEW=30s
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=./data/objects
# Docker 내부 S3 통신은 compose의 http://minio:9000을 사용합니다.
# 아래 public endpoint는 host browser가 접근할 수 있어야 합니다.
MINIO_API_PORT=9000
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PATH_STYLE_ACCESS=true
OBJECT_STORAGE_CONNECT_TIMEOUT=3s
OBJECT_STORAGE_READ_TIMEOUT=30s
OBJECT_STORAGE_PRESIGNED_GET_EXPIRY=5m
OBJECT_STORAGE_PRESIGNED_PUT_EXPIRY=5m
OBJECT_STORAGE_ARTIFACT_MAX_SIZE=32MB
AI_ARTIFACT_HTTP_TIMEOUT_SECONDS=10
AI_ARTIFACT_MAX_BYTES=1048576

# ============================================================
# 5. DIRECT RUN ONLY
# ============================================================
# Compose injects fixed service URLs and maps the shared internal token automatically.
AI_SERVER_BASE_URL=http://127.0.0.1:8000
AI_SERVER_INTERNAL_API_KEY=
BACKEND_INTERNAL_BASE_URL=http://127.0.0.1:8080
AI_IMAGE_MODEL=gpt-image-2
TWIN_BANK_DIR=

DB_URL=jdbc:postgresql://localhost:5432/aivle
DB_USERNAME=aivle
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000

# ============================================================
# 6. TEST / E2E ONLY
# ============================================================
# Production behavior never uses fixture success fallback or failure injection.
AI_FIXTURE_MODE=false
AI_CONCEPT_TEST_FAILURE_INJECTION=false
AI_CONCEPT_TEST_FAILURE_PLAN=
AI_E2E_FAULTS_ENABLED=false
AI_E2E_FAULT_MODE=
AI_E2E_FAULT_DELAY_SECONDS=5
APP_E2E_DEFER_ARTIFACT_WAKE=false
VITE_ENABLE_PIPELINE_DEBUG=false
