{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketingContentRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "marketingSourceSnapshotId",
    "contentType",
    "channel",
    "purpose",
    "tone",
    "length"
  ],
  "properties": {
    "contract": {
      "const": "marketing-content-request-v1"
    },
    "marketingSourceSnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "referenceArtifactId": {
      "description": "선택적으로 이미지 생성·편집에 사용할 동일 프로젝트의 PNG/JPEG 근거 아티팩트 ID",
      "type": ["string", "null"],
      "format": "uuid"
    },
    "contentType": {
      "enum": [
        "SOCIAL_POST",
        "AD_COPY",
        "LANDING_PAGE",
        "BLOG_INTRO",
        "EMAIL",
        "BANNER",
        "POSTER",
        "IMAGE_BRIEF"
      ]
    },
    "channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "tone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "length": {
      "enum": [
        "SHORT",
        "MEDIUM",
        "LONG"
      ]
    },
    "requiredPhrases": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "excludedPhrases": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "additionalInstruction": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
