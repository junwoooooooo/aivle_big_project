{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketingContentResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contentType", "title", "body", "callToAction", "hashtags", "imageBrief", "legalReview", "artifactRefs"],
  "properties": {
    "contract": {"const": "marketing-content-result-v1"},
    "contentType": {"enum": ["SOCIAL_POST", "AD_COPY", "LANDING_PAGE", "BLOG_INTRO", "EMAIL", "BANNER", "POSTER", "IMAGE_BRIEF"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "body": {"type": "string", "minLength": 1, "maxLength": 20000},
    "callToAction": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
    "hashtags": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "imageBrief": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000},
    "legalReview": {
      "type": "object", "additionalProperties": false,
      "required": ["compliant", "warnings", "requiredDisclosuresApplied"],
      "properties": {
        "compliant": {"type": "boolean"},
        "warnings": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "requiredDisclosuresApplied": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "artifactRefs": {
      "description": "내부 오브젝트 스토리지에 저장된 생성 JPEG 이미지 참조(최대 1개)",
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ai-artifacts/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.jpg$",
        "maxLength": 300
      }
    }
  }
}
