{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelectedConceptMarketInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "projectId",
    "selectionId",
    "inputSnapshotId",
    "concept",
    "legalAssessment",
    "snapshotHash",
    "createdAt"
  ],
  "properties": {
    "contract": {
      "const": "selected-concept-market-input-v1"
    },
    "projectId": {
      "type": "integer"
    },
    "selectionId": {
      "type": "integer"
    },
    "inputSnapshotId": {
      "type": "string"
    },
    "concept": {
      "type": "object"
    },
    "legalAssessment": {
      "type": "object"
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^sha256:"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
