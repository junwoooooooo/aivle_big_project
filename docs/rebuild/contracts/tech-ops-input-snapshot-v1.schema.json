{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechOpsInputSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaVersion", "snapshotId", "hash", "createdAt", "projectId", "preparationId", "sourceMarketSeedSnapshotId", "sourceSnapshotHash", "requiredFacts", "requiredFactProvenance", "requiredDecisions", "evidenceReferences"],
  "properties": {
    "contract": { "const": "tech-ops-input-snapshot-v1" },
    "schemaVersion": { "const": "2.0" },
    "snapshotId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "hash": { "$ref": "#/$defs/hash" },
    "createdAt": { "type": "string", "format": "date-time" },
    "projectId": { "type": "integer" },
    "preparationId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sourceMarketSeedSnapshotId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sourceSnapshotHash": { "$ref": "#/$defs/hash" },
    "requiredFacts": { "$ref": "#/$defs/requiredFacts" },
    "requiredFactProvenance": { "$ref": "#/$defs/requiredFactProvenance" },
    "requiredDecisions": { "$ref": "#/$defs/requiredDecisions" },
    "evidenceReferences": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/evidence" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "textArray": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "productSpecification": {
      "type": "object", "additionalProperties": false, "required": ["summary", "features"],
      "properties": { "summary": { "type": "string", "minLength": 1, "maxLength": 4000 }, "features": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 500 } } }
    },
    "personnel": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": { "type": "object", "additionalProperties": false, "required": ["role", "count"], "properties": { "role": { "type": "string", "minLength": 1, "maxLength": 200 }, "count": { "type": "integer", "minimum": 0 }, "notes": { "type": "string", "maxLength": 1000 } } }
    },
    "cost": {
      "type": "object", "additionalProperties": false, "required": ["amount", "currency"],
      "properties": { "amount": { "type": "number", "minimum": 0 }, "currency": { "type": "string", "minLength": 1, "maxLength": 20 }, "period": { "type": "string", "maxLength": 50 }, "description": { "type": "string", "maxLength": 1000 } }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["year", "value"],
      "properties": { "year": { "type": "integer", "minimum": 1, "maximum": 3 }, "value": { "type": "number", "minimum": 0 } }
    },
    "targets": {
      "type": "object", "additionalProperties": false, "required": ["metric", "unit", "years"],
      "properties": { "metric": { "enum": ["salesVolume", "customerCount", "subscriberCount", "transactionCount"] }, "unit": { "type": "string", "minLength": 1 }, "years": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/target" } } }
    },
    "requiredFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["productServiceSpecification", "targetLaunchDate", "ownedPersonnel", "ownedAssetsAndFacilities", "fixedOperatingCost", "initialInvestment", "threeYearTargets"],
      "properties": {
        "productServiceSpecification": { "$ref": "#/$defs/productSpecification" },
        "targetLaunchDate": { "type": "string", "format": "date" },
        "ownedPersonnel": { "$ref": "#/$defs/personnel" },
        "ownedAssetsAndFacilities": { "$ref": "#/$defs/textArray" },
        "fixedOperatingCost": { "$ref": "#/$defs/cost" },
        "initialInvestment": { "$ref": "#/$defs/cost" },
        "threeYearTargets": { "$ref": "#/$defs/targets" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": true,
      "required": ["value", "source", "decision", "readOnly", "sourceSnapshotId"],
      "properties": { "value": {}, "source": { "type": "string" }, "decision": { "type": "string" }, "readOnly": { "type": "boolean" }, "sourceSnapshotId": { "type": ["string", "null"] } }
    },
    "requiredFactProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["productServiceSpecification", "targetLaunchDate", "ownedPersonnel", "ownedAssetsAndFacilities", "fixedOperatingCost", "initialInvestment", "threeYearTargets"],
      "properties": {
        "productServiceSpecification": { "$ref": "#/$defs/provenance" }, "targetLaunchDate": { "$ref": "#/$defs/provenance" },
        "ownedPersonnel": { "$ref": "#/$defs/provenance" }, "ownedAssetsAndFacilities": { "$ref": "#/$defs/provenance" },
        "fixedOperatingCost": { "$ref": "#/$defs/provenance" }, "initialInvestment": { "$ref": "#/$defs/provenance" }, "threeYearTargets": { "$ref": "#/$defs/provenance" }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["value", "source", "decision", "proposalVersion"],
      "properties": { "value": {}, "source": { "enum": ["USER_INPUT", "AI_HYPOTHESIS", "CONCEPT_GENERATED", "ANALYSIS_RESULT"] }, "decision": { "enum": ["ACCEPTED", "USER_EDITED_ACCEPTED"] }, "proposalVersion": { "type": "integer", "minimum": 1 } }
    },
    "requiredDecisions": {
      "type": "object", "additionalProperties": false,
      "required": ["deliveryOrProductionMethod", "expectedMonthlyThroughputOrSales", "technicalSupplyOperationalConstraints"],
      "properties": { "deliveryOrProductionMethod": { "$ref": "#/$defs/decision" }, "expectedMonthlyThroughputOrSales": { "$ref": "#/$defs/decision" }, "technicalSupplyOperationalConstraints": { "$ref": "#/$defs/decision" } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidenceId", "evidenceType", "artifactId", "originalFilename", "displayName", "mediaType", "sizeBytes", "sha256", "source"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "evidenceType": { "enum": ["QUOTE", "BOM", "SUPPLIER", "SPECIFICATION", "PILOT"] },
        "artifactId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "originalFilename": { "type": "string", "minLength": 1, "maxLength": 255 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 150 },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "description": { "type": "string", "maxLength": 1000 },
        "source": { "const": "USER_PROVIDED_EVIDENCE" }
      }
    }
  }
}
