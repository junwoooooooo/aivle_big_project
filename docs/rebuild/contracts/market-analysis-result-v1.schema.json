{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketAnalysisResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "moduleRunId", "inputSnapshotId", "status", "resultReference", "summary", "competitors", "completedAt", "resultHash"],
  "properties": {
    "contract": { "const": "market-analysis-result-v1" },
    "moduleRunId": { "type": "string" },
    "inputSnapshotId": { "type": "string" },
    "status": { "enum": ["COMPLETED", "FAILED", "NEEDS_INPUT"] },
    "resultReference": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["marketSummary", "targetCustomerImplications", "pricingAndChannelImplications"],
      "properties": {
        "marketSummary": { "type": "string", "minLength": 1 },
        "targetCustomerImplications": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "pricingAndChannelImplications": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productName", "companyName", "officialUrl", "description", "priceEvidence", "keyFeatures", "targetCustomer", "researchedAt", "sourceReferences", "verificationStatus"],
        "properties": {
          "productName": { "type": "string", "minLength": 1 },
          "companyName": { "type": "string", "minLength": 1 },
          "officialUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "description": { "type": "string", "minLength": 1 },
          "priceEvidence": { "type": "object" },
          "keyFeatures": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "targetCustomer": { "type": "string", "minLength": 1 },
          "researchedAt": { "type": "string", "format": "date-time" },
          "sourceReferences": { "$ref": "#/$defs/sourceReferences" },
          "verificationStatus": { "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "NEEDS_REVIEW"] }
        }
      }
    },
    "completedAt": { "type": "string", "format": "date-time" },
    "resultHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "resultHash를 제외한 canonical JSON의 SHA-256"
    }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "COMPLETED" } } },
    "then": { "properties": { "competitors": { "minItems": 1 } } }
  }],
  "$defs": {
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "accessedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
