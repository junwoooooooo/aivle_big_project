# Disposable Docker E2E only. Never use this file for the official Journey or deployment.
# Provider calls are pointed at a non-listening loopback endpoint and must fail immediately.
AI_PROVIDER=openai-compatible
AI_API_KEY=e2e-not-a-real-provider-key
AI_MODEL=e2e-no-provider-model
AI_BASE_URL=http://127.0.0.1:9/v1
AI_INTERNAL_SERVICE_TOKEN=e2e-internal-token-not-for-shared-use
AI_FIXTURE_MODE=false

POSTGRES_DB=aivle
POSTGRES_USER=aivle
POSTGRES_PASSWORD=e2e-postgres-password
POSTGRES_PORT=5432

JWT_SECRET=e2e-only-jwt-secret-replace-before-shared-use

MINIO_ROOT_USER=aivle-e2e
MINIO_ROOT_PASSWORD=e2e-minio-password
OBJECT_STORAGE_BUCKET=aivle-ai-artifacts
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

FRONTEND_PORT=3000
JAEMU_PORT=3001
BACKEND_PORT=8080
AI_SERVER_PORT=8000

# Browser traffic uses the frontend reverse proxy, so no VITE_API_BASE_URL is
# required. These origins are only needed for direct backend access in E2E.
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_ENVIRONMENT=E2E
