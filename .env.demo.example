# Legacy stable-core demo only.
# Starts Backend and Frontend directly, uses /api/v1, and relies on local/H2 settings.
# It does not start FastAPI, PostgreSQL, or MinIO and is not an official Journey runner.
# For the official Idea -> Legal -> Concept Journey, use .env.example + docker compose.

# Backend
JWT_SECRET=replace-with-at-least-32-byte-secret
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
APP_ENVIRONMENT=LOCAL

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Optional legacy Spring direct-provider adapter settings. FastAPI is not started.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_PROVIDER_TIMEOUT_SECONDS=60
