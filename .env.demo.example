# Backend
JWT_SECRET=replace-with-at-least-32-byte-secret
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
APP_ENVIRONMENT=LOCAL

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Demo mode
AI_PROVIDER=mock
DOCUMENT_JOB_RUNNER_ENABLED=true

AI_API_KEY=

# AI 서버 (ai/) — Spring 의 app.ai-server.base-url
AI_SERVER_BASE_URL=http://127.0.0.1:8000
AI_SERVER_PORT=8000

# 법률 검토 provider: auto(=app.ai.enabled 따름) | mock | openai | pipeline
# pipeline 을 쓰려면 AI 서버가 함께 떠 있어야 한다.
LEGAL_PROVIDER=pipeline
LEGAL_SERVICE_URL=http://127.0.0.1:8000/legal-review

# 라우팅·선별 LLM 백엔드
#   auto        = ANTHROPIC_API_KEY 있으면 anthropic, 없으면 claude-cli
#   anthropic   = API 키로 직접 호출 (토큰 효율이 좋다)
#   claude-cli  = Claude Code 로그인 세션 사용 (API 키 불필요).
#                 호출마다 Claude Code 시스템 프롬프트 ~47k 토큰이 함께 청구되고
#                 구독 사용량을 소모한다. 로컬 데모용.
LEGAL_LLM_BACKEND=auto
ANTHROPIC_API_KEY=
LEGAL_CLI_TIMEOUT=900
# 법제처 Open API OC. 비우면 공개 테스트 ID(test)를 쓴다 — 운영 전 발급 권장.
LAW_API_OC=

# 법령 조사는 조문 수에 비례한다. 조문 100건대 3분, 200건대 10분 이상.
# 이 값들이 LEGAL_READ_TIMEOUT보다 작으면 완료 직전에 끊겨 재시도 루프가 된다.
#   LEGAL_READ_TIMEOUT < DOCUMENT_JOB_EXECUTION_TIMEOUT < DOCUMENT_JOB_STALE_TIMEOUT
LEGAL_READ_TIMEOUT=1800s
DOCUMENT_JOB_EXECUTION_TIMEOUT=35m
DOCUMENT_JOB_STALE_TIMEOUT=40m
