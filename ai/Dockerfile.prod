FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./

RUN pip install --no-cache-dir --requirement requirements.txt \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /app app

COPY --chown=app:app main.py ./
COPY --chown=app:app app ./app
COPY --chown=app:app assets ./assets

# Production에서는 Twin Bank를 이미지에 포함하지 않는다.
# EC2 host의 비공개 디렉터리를 runtime에 read-only bind mount한다.
RUN rm -rf /app/app/twin/bank \
    && mkdir -p /app/app/twin/bank /app/outputs \
    && chown -R app:app /app/app/twin/bank /app/outputs

USER app

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=12 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=2)"

# Twin Bank mount가 빠진 상태로 조용히 서비스가 뜨는 것을 방지한다.
CMD ["sh", "-ec", "test -s /app/app/twin/bank/twin_bank_manifest.json || { echo 'ERROR: production Twin Bank mount is missing.' >&2; exit 1; }; exec uvicorn main:app --host 0.0.0.0 --port 8000"]