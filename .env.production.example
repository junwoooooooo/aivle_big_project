# ============================================================
# AWS Production configuration template
# 실제 secret 값은 이 파일에 넣지 않는다.
# ============================================================

# ------------------------------------------------------------
# 1. Container images
# AWS ECR 생성 후 실제 URI로 교체
# ------------------------------------------------------------
AI_IMAGE=REPLACE_ME_AI_IMAGE
BACKEND_IMAGE=REPLACE_ME_BACKEND_IMAGE
FRONTEND_IMAGE=REPLACE_ME_FRONTEND_IMAGE

# ------------------------------------------------------------
# 2. EC2 runtime
# ------------------------------------------------------------
FRONTEND_PORT=80
TWIN_BANK_HOST_DIR=/opt/aivle/private/twin-bank

# ------------------------------------------------------------
# 3. Database - AWS RDS PostgreSQL
# RDS 생성 후 실제 endpoint로 교체
# ------------------------------------------------------------
DB_URL=jdbc:postgresql://REPLACE_ME_RDS_ENDPOINT:5432/aivle
DB_USERNAME=aivle_admin
DB_PASSWORD=REPLACE_ME_SECRET

# ------------------------------------------------------------
# 4. Application security
# 실제 값은 서버에서만 설정
# ------------------------------------------------------------
JWT_SECRET=REPLACE_ME_SECRET
AI_INTERNAL_SERVICE_TOKEN=REPLACE_ME_SECRET

# ------------------------------------------------------------
# 5. Main AI
# 현재 로컬에서 정상 동작 중인 값과 동일하게 사용
# ------------------------------------------------------------
AI_PROVIDER=REPLACE_ME
AI_API_KEY=REPLACE_ME_SECRET
AI_MODEL=REPLACE_ME

FINAL_BUSINESS_PROPOSAL_MODEL=gpt-4.1-mini

# ------------------------------------------------------------
# 6. Market Research
# 현재 로컬에서 사용하는 key/model 정책 유지
# ------------------------------------------------------------
MARKET_RESEARCH_OPENAI_API_KEY=REPLACE_ME_SECRET
OPENAI_API_KEY=
OPENAI_BASE_URL=

MARKET_SEARCH_MODEL=gpt-5.4-nano
MARKET_EXTRACT_MODEL=gpt-5.6-luna
MARKET_DESIGN_MODEL=gpt-5.6-luna

# 현재 Market Worker 예산은 60분이므로
# Backend transport timeout은 63분으로 둔다.
AI_SERVER_MARKET_RESEARCH_READ_TIMEOUT=63m

# ------------------------------------------------------------
# 7. External data APIs
# 사용 중인 값만 서버에서 실제 key로 설정
# ------------------------------------------------------------
KOSIS_API_KEY=
DART_API_KEY=
TAVILY_API_KEY=
MOLEG_API_KEY=

MOLEG_API_BASE_URL=https://www.law.go.kr/DRF
LEGAL_REGISTRY_VERSION=legal-registry-v1

# ------------------------------------------------------------
# 8. Optional workload/model overrides
# 로컬 .env에서 별도 값을 사용 중이면 그대로 복사
# ------------------------------------------------------------
MARKET_INTERVIEW_MODEL=
MARKET_INTERVIEW_TEMPERATURE=1.0
MARKET_INTERVIEW_REASONING_EFFORT=
MARKET_INTERVIEW_CONCURRENCY=4

MARKETING_COPY_MODEL=gpt-4o-mini
MARKETING_IMAGE_MODEL=gpt-image-2

AI_MODEL_CONCEPT_VALIDATION=
AI_BASE_URL=

BM_MODEL=
BM_REASONING_EFFORT=

TECH_OPS_ADVISOR_MODEL=
TECH_OPS_ENABLE_DART_CORP_LOOKUP=false

TWIN_CONCURRENCY=32

# ------------------------------------------------------------
# 9. Amazon S3
# Bucket 생성 후 이름만 실제 값으로 교체
# Access Key/Secret Key는 비워 둔다.
# EC2 IAM Role을 사용한다.
# ------------------------------------------------------------
OBJECT_STORAGE_BUCKET=REPLACE_ME_S3_BUCKET
OBJECT_STORAGE_REGION=us-east-1

OBJECT_STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://s3.us-east-1.amazonaws.com

OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

OBJECT_STORAGE_PATH_STYLE_ACCESS=false
OBJECT_STORAGE_ARTIFACT_MAX_SIZE=32MB

# AI가 S3 artifact를 읽을 때 허용할 origin.
# S3 bucket 생성 후 REPLACE_ME_S3_BUCKET 부분 교체.
AI_ARTIFACT_ALLOWED_ORIGINS=https://REPLACE_ME_S3_BUCKET.s3.us-east-1.amazonaws.com

# ------------------------------------------------------------
# 10. Browser / ALB
# ALB 생성 후 DNS name으로 교체
# 예:
# http://aivle-bp-prod-alb-123456.us-east-1.elb.amazonaws.com
# ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://REPLACE_ME_ALB_DNS